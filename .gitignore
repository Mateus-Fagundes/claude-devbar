# Allowlist: everything stays out except what belongs to the mod.
# A new file at the root or in .claude-plugin/ only gets in if allowed here.
/*
!/.gitignore

# Manifest (and the marketplace.json for publishing). types/ is generated by Claude Code on every load.
!/.claude-plugin/
/.claude-plugin/*
!/.claude-plugin/plugin.json
!/.claude-plugin/marketplace.json

# Code, the $.state contract, tests and tsconfig (extends the engine's).
!/hooks/
!/types/
!/tests/
!/tsconfig.json

# Repo docs and the README images.
!/README*.md
!/LICENSE
!/SECURITY.md
!/assets/

# OS and editor junk, even inside the allowed folders.
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.swp
*~
